# Variáveis de Ambiente - NoraHub
# IMPORTANTE: Nunca commite este arquivo com valores reais!

# Firebase Configuration — copie do console Firebase > Configurações do projeto > Seus apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini AI (opcional)
VITE_GEMINI_API_KEY=your_gemini_key

# Resend Email Service (opcional)
VITE_RESEND_API_KEY=re_your_resend_key

# reCAPTCHA v3 (recomendado)
# ATENÇÃO: Gere novas chaves em https://www.google.com/recaptcha/admin — as chaves anteriores foram expostas e devem ser REVOGADAS
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Environment
VITE_ENVIRONMENT=production

# Security Headers (opcional - sobrescrever padrões)
VITE_CSP_REPORT_URI=https://your-domain.com/csp-report

# AWS CloudFront Distribution (após configurar)
VITE_CLOUDFRONT_DOMAIN=your-cloudfront-url.cloudfront.net

# Monitoring & Analytics (opcional)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_ANALYTICS_ID=your_analytics_id
