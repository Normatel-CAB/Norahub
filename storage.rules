rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: usuário autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: verifica cargo via Firestore (apenas disponível no Storage rules v2)
    // Admin ou gerente: tem permissão total nos arquivos de projetos
    function isAdminOrManager() {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.funcao == 'admin' ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.funcao.matches('.*gerente.*')
      );
    }

    // Fotos de perfil — leitura pública, escrita apenas pelo próprio usuário
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Arquivos de projetos — leitura para qualquer autenticado
    // Escrita e deleção apenas para admin ou gerente
    match /projetos/{projectId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isAdminOrManager()
                    && request.resource.size < 50 * 1024 * 1024; // 50 MB máx
      allow update: if isAdminOrManager()
                    && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdminOrManager();
    }

    // Bloquear tudo que não foi explicitamente permitido
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
