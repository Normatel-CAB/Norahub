rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.funcao == 'admin';
    }

    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.funcao.lower().matches('.*gerente.*');
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function isValidStringLength(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isSafeString(value) {
      return value is string &&
        !value.matches('(?i).*<script[^>]*>.*') &&
        !value.matches('(?i).*javascript\\s*:.*') &&
        !value.matches('(?i).*\\bon(error|click|load|mouseover|submit|focus|blur)\\s*=.*') &&
        !value.matches('(?i).*<\\s*(iframe|object|embed|applet|form|input|button).*') &&
        !value.matches('(?i).*data\\s*:.*text/html.*') &&
        !value.matches('(?i).*vbscript\\s*:.*');
    }

    function isValidDocumentSize() {
      return request.resource.size() < 1048576;
    }

    // ── usuarios ─────────────────────────────────────────────────────────────────
    // Próprio usuário lê e atualiza. Admin/gerente leem todos (necessário para
    // AdminDashboard e GerenciaProjetos). Apenas admin pode mudar funcao.
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isAdminOrManager()
      );
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidDocumentSize() &&
        request.resource.data.keys().hasAll(['nome', 'email', 'funcao']) &&
        isValidStringLength(request.resource.data.nome, 2, 100) &&
        isSafeString(request.resource.data.nome) &&
        isSafeString(request.resource.data.email);
      allow update: if isSignedIn() &&
        (request.auth.uid == userId || isAdminOrManager()) &&
        isValidDocumentSize() &&
        (!('funcao' in request.resource.data.diff(resource.data).affectedKeys()) || isAdmin()) &&
        (!('nome' in request.resource.data) || isSafeString(request.resource.data.nome));
      allow delete: if isAdmin();
    }

    // ── users (legado — somente admin pode escrever) ──────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminOrManager());
      allow create, update, delete: if isAdmin();
    }

    // ── projetos ──────────────────────────────────────────────────────────────────
    match /projetos/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isAdminOrManager() &&
        isValidDocumentSize() &&
        isValidStringLength(request.resource.data.nome, 2, 200) &&
        isSafeString(request.resource.data.nome);
      allow update: if isSignedIn() &&
        isAdminOrManager() &&
        isValidDocumentSize();
      allow delete: if isAdmin();
    }

    // ── cargos ────────────────────────────────────────────────────────────────────
    match /cargos/{cargoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() &&
        isValidDocumentSize() &&
        isSafeString(request.resource.data.get('nome', ''));
    }

    // ── formularios ──────────────────────────────────────────────────────────────
    match /formularios/{formId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidDocumentSize();
      allow delete: if isAdmin();
    }

    // ── security_logs (escrita exclusiva por Cloud Functions via Admin SDK) ───────
    match /security_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── rate_limits (exclusivo Cloud Functions) ───────────────────────────────────
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // ── arquivos ──────────────────────────────────────────────────────────────────
    match /arquivos/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDocumentSize();
      allow update: if isSignedIn() && (
        resource.data.uploadedBy == request.auth.uid || isAdminOrManager()
      );
      allow delete: if isSignedIn() && (
        resource.data.uploadedBy == request.auth.uid || isAdminOrManager()
      );
    }

    // ── notifications ─────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── activities (imutável após criação) ────────────────────────────────────────
    match /activities/{activityId} {
      allow read: if isAdminOrManager() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidDocumentSize();
      allow update, delete: if false;
    }

    // ── settings ──────────────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── favorites ─────────────────────────────────────────────────────────────────
    match /favorites/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── carteiras ─────────────────────────────────────────────────────────────────
    match /carteiras/{carteiraId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrManager();
      allow delete: if isAdminOrManager();
    }
  }
}
